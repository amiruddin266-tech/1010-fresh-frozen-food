NODE_ENV=production
PORT=3000
SITE_URL=https://your-domain.com
STORE_NAME=1010 Fresh Frozen Food
STORE_DESCRIPTION=Fresh frozen chicken delivered to your door in Malaysia.

# Server-side road distance lookup. Replace these endpoints with your paid provider if needed.
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
DELIVERY_ORIGIN_KUALA_TERENGGANU=Near SMK Sri Nilam, Kuala Terengganu, Malaysia
DELIVERY_ORIGIN_KUALA_BERANG=Kampung Langgar, Kuala Berang, Malaysia

# Billplz: use production values when going live.
BILLPLZ_API_URL=https://www.billplz.com/api
BILLPLZ_SECRET_KEY=replace_me
BILLPLZ_COLLECTION_ID=replace_me
BILLPLZ_X_SIGNATURE_KEY=replace_me
BILLPLZ_CALLBACK_URL=https://your-domain.com/api/payments/billplz/callback
BILLPLZ_REDIRECT_URL=https://your-domain.com/payment-result

# Store owner notifications
OWNER_NAME=1010 Fresh Frozen Food
OWNER_EMAIL=owner@example.com
OWNER_WHATSAPP=60123456789

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=owner@example.com
SMTP_PASS=replace_me
SMTP_FROM="1010 Fresh Frozen Food <owner@example.com>"

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en

# Admin dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_to_a_long_random_password
